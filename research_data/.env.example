# Nutrient Earth — Research Data Acquisition Environment Variables
# Copy this file to .env and provide your personal credentials where required.
# DO NOT commit real API keys or secrets to version control.

# National Informatics Centre / Open Government Data Platform India
OGD_INDIA_API_KEY=

# OpenAQ Global Physical Air Quality Platform (API v3)
OPENAQ_API_KEY=

# International Union for Conservation of Nature (IUCN) Red List Token
IUCN_API_TOKEN=

# National Center for Biotechnology Information (NCBI) E-utilities Key (Increases rate limit to 10 req/s)
NCBI_API_KEY=

# Open Science Framework (OSF) Personal Access Token
OSF_PERSONAL_TOKEN=

# Zenodo Personal Access Token
ZENODO_ACCESS_TOKEN=

# Open-Meteo Commercial API Key (Optional; free evaluation tier requires no key)
OPEN_METEO_API_KEY=

# Target Database Connection String (for pg_loader.py)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

